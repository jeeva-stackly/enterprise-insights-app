# Copy this file to ".env" and fill in your own values. ".env" is git-ignored; never commit it.

# SQLAlchemy URL: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
# If the password contains special characters (@ : / # %), URL-encode them (e.g. @ -> %40).
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/insights_db

# Comma-separated list of allowed origins, or * for development.
CORS_ORIGINS=*

# Reporting window used by the dashboard KPIs (days). Compared with the previous window of equal length.
KPI_PERIOD_DAYS=30

# Placeholder profile until authentication is added in a later task.
DEFAULT_USER_NAME=Jeeva
DEFAULT_USER_ROLE=Regional Manager

# Set to true to log every SQL statement (development only).
DB_ECHO=false